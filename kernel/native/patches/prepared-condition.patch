+use cedar_policy_core::{
+    ast::*,
+    entities::{err::EntitiesError, Dereference, Entities, EntityJsonParser, Schema, TCComputation},
+    evaluator::Evaluator,
+    extensions::Extensions,
+};
+use cedar_policy_validator::{ActionBehavior, CoreSchema, ValidatorSchema, ValidatorSchemaFragment};
+use serde_json::{json, Value};
+use std::{collections::HashSet, sync::Arc};
+
+fn uid(text: &str) -> EntityUID { text.parse().unwrap() }
+
+fn sorted(mut value: Value) -> Value {
+    value.as_array_mut().unwrap().sort_by_key(Value::to_string);
+    value
+}
+
+#[test]
+fn layered_store_preserves_full_normalized_store_semantics() {
+    let extensions = Extensions::all_available();
+    let fragment = ValidatorSchemaFragment::from_schema_fragment(
+        serde_json::from_value(json!({"": {
+            "entityTypes": {"User": {"memberOfTypes": ["User"]}},
+            "actions": {
+                "group": {},
+                "unrelated": {"attributes": {"flag": true}, "memberOf": [{"id": "group"}]},
+                "read": {"appliesTo": {"principalTypes": ["User"], "resourceTypes": ["User"]}}
+            }
+        }})).unwrap(), ActionBehavior::PermitAttributes, extensions,
+    ).unwrap();
+    let schema = ValidatorSchema::from_schema_fragments([fragment], extensions).unwrap();
+    let core = CoreSchema::new(&schema);
+    let user = Entity::new_with_attr_partial_value(uid(r#"User::"u""#), [],
+        HashSet::from([uid(r#"User::"missing""#)]));
+    let store = Entities::from_entities([user.clone()], Some(&core), TCComputation::ComputeNow, extensions).unwrap();
+    assert_eq!(store.iter().count(), 4);
+    assert!(matches!(store.entity(&uid(r#"User::"missing""#)), Dereference::NoSuchEntity));
+    let action = core.action(&uid(r#"Action::"unrelated""#)).unwrap();
+    let base = core.action_entity_index().unwrap();
+    let base_refs = Arc::strong_count(&base);
+    let action_refs = Arc::strong_count(&action);
+    let second = Entities::from_entities([user.clone(), action.as_ref().clone()], Some(&core), TCComputation::ComputeNow, extensions).unwrap();
+    assert_eq!(Arc::strong_count(&base), base_refs + 1);
+    assert_eq!(Arc::strong_count(&action), action_refs);
+    assert_eq!(store, second);
+    drop(second);
+    assert_eq!(Arc::strong_count(&base), base_refs);
+    let request = Request::new_unchecked(
+        EntityUIDEntry::known(user.uid().clone(), None),
+        EntityUIDEntry::known(uid(r#"Action::"read""#), None),
+        EntityUIDEntry::known(user.uid().clone(), None), Some(Context::empty()),
+    );
+    let policy = cedar_policy_core::parser::parse_policy(None,
+        r#"permit(principal, action, resource) when { Action::"unrelated".flag && Action::"unrelated" in Action::"group" };"#,
+    ).unwrap();
+    assert!(Evaluator::new(request, &store, extensions).evaluate(&policy.into()).unwrap());
+
+    // A flat equivalent is an independent oracle for all logical-store APIs.
+    let flat = Entities::from_entities(store.clone(), None::<&CoreSchema<'_>>,
+        TCComputation::EnforceAlreadyComputed, extensions).unwrap();
+    assert_eq!(store, flat);
+    assert_eq!(sorted(store.to_json_value().unwrap()), sorted(flat.to_json_value().unwrap()));
+    let serialized = serde_json::to_value(&store).unwrap();
+    assert_eq!(serialized.as_object().unwrap().len(), 1);
+    assert_eq!(sorted(serialized["entities"].clone()), sorted(serde_json::to_value(&flat).unwrap()["entities"].clone()));
+    let debug = format!("{store:?}");
+    assert!(debug.starts_with("Entities { entities:"));
+    assert!(debug.contains("unrelated") && debug.contains("flag") && !debug.contains("schema_actions"));
+    assert!(store.to_string().contains("unrelated"));
+    assert!(store.to_dot_str().contains("unrelated"));
+    let reparsed = EntityJsonParser::new(None::<&CoreSchema<'_>>, extensions, TCComputation::ComputeNow)
+        .from_json_value(store.to_json_value().unwrap()).unwrap();
+    assert_eq!(store, reparsed);
+    let _: std::iter::Map<std::collections::hash_map::IntoValues<EntityUID, Arc<Entity>>, fn(Arc<Entity>) -> Entity> = store.clone().into_iter();
+    for mode in [TCComputation::AssumeAlreadyComputed, TCComputation::EnforceAlreadyComputed, TCComputation::ComputeNow] {
+        assert_eq!(store, Entities::from_entities([user.clone(), action.as_ref().clone()], Some(&core), mode, extensions).unwrap());
+    }
+    let matching = action.as_ref().clone();
+    assert!(matches!(Entities::from_entities([matching.clone(), matching.clone()], Some(&core), TCComputation::ComputeNow, extensions), Err(EntitiesError::Duplicate(_))));
+    let mismatch = Entity::with_uid(action.uid().clone());
+    assert!(matches!(Entities::from_entities([mismatch.clone()], Some(&core), TCComputation::ComputeNow, extensions), Err(EntitiesError::InvalidEntity(_))));
+    let cycle = Entity::new_with_attr_partial_value(uid(r#"User::"cycle""#), [], HashSet::from([uid(r#"User::"cycle""#)]));
+    assert!(matches!(Entities::from_entities([cycle, mismatch], Some(&core), TCComputation::ComputeNow, extensions), Err(EntitiesError::TransitiveClosureError(_))));
+    let unknown = Entity::new_with_attr_partial_value(uid(r#"User::"bad""#), [], HashSet::from([uid(r#"Unknown::"parent""#)]));
+    assert!(matches!(Entities::from_entities([unknown], Some(&core), TCComputation::ComputeNow, extensions), Err(EntitiesError::InvalidEntity(_))));
+    assert!(matches!(store.clone().add_entities([Arc::clone(&action)], Some(&core), TCComputation::ComputeNow, extensions), Err(EntitiesError::Duplicate(_))));
+    let added = store.clone().add_entities([Arc::new(Entity::with_uid(uid(r#"User::"new""#)))], Some(&core), TCComputation::ComputeNow, extensions).unwrap();
+    assert_eq!(added.iter().count(), 5);
+    assert!(matches!(added.entity(action.uid()), Dereference::Data(_)));
+    #[cfg(feature = "partial-eval")]
+    {
+        let partial = store.clone().partial();
+        assert!(matches!(partial.entity(action.uid()), Dereference::Data(_)));
+        assert!(matches!(partial.entity(user.uid()), Dereference::Data(_)));
+        assert!(matches!(partial.entity(&uid(r#"User::"missing""#)), Dereference::Residual(_)));
+        assert_ne!(partial, store);
+        assert_eq!(sorted(partial.to_json_value().unwrap()), sorted(store.to_json_value().unwrap()));
+    }
+}

import io.github.gmcnicol.kernel.taxi.Contract
import io.github.gmcnicol.kernel.taxi.ProjectedState
import io.github.gmcnicol.kernel.taxi.Fact
import io.github.gmcnicol.kernel.taxi.Event

namespace io.github.gmcnicol.crm.compatibility.v1

@Contract(version = 1, family = "io.github.gmcnicol.crm.compatibility.ContactProjection")
@ProjectedState(subject = "io.github.gmcnicol.crm.CompatibilityContactId")
model ContactProjection {
    contactId: io.github.gmcnicol.crm.CompatibilityContactId
    displayName: String
}

@Contract(version = 1, family = "io.github.gmcnicol.crm.compatibility.ContactEngagementSignal")
@Fact(projection = "io.github.gmcnicol.crm.compatibility.v1.ContactProjection")
model FollowUpSignal {
    contactId: io.github.gmcnicol.crm.CompatibilityContactId
    signal: String
}

@Contract(version = 1, family = "io.github.gmcnicol.crm.compatibility.RecordContactEngagement")
model RecordContactInteractionRequest {
    note: String
}

@Contract(version = 1, family = "io.github.gmcnicol.crm.compatibility.ContactEngagementRecorded")
@Event
closed model ContactInteractionRecorded {
    contactId: io.github.gmcnicol.crm.CompatibilityContactId
}

@Contract(version = 1, family = "io.github.gmcnicol.crm.compatibility.ContactEngagementDeferred")
@Event
closed model ContactFollowUpDeferred {
    contactId: io.github.gmcnicol.crm.CompatibilityContactId
}

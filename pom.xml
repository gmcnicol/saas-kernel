<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>io.github.gmcnicol</groupId>
    <artifactId>saas-kernel-reactor</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>SaaS Kernel Reactor</name>
    <description>Product-neutral semantic workflow mechanics for Spring Boot Applications.</description>
    <url>https://github.com/gmcnicol/saas-kernel</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <name>Gareth McNicol</name>
            <email>1968845+gmcnicol@users.noreply.github.com</email>
            <url>https://github.com/gmcnicol</url>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/gmcnicol/saas-kernel.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/gmcnicol/saas-kernel.git</developerConnection>
        <url>https://github.com/gmcnicol/saas-kernel</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>kernel</module>
        <module>applications/keep-in-touch-crm</module>
        <module>applications/ledgerling</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <spring-modulith.version>2.1.0</spring-modulith.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <taxi.version>1.70.0</taxi.version>
        <cedar-java.version>4.2.3</cedar-java.version>
        <maven-antrun-plugin.version>3.2.0</maven-antrun-plugin.version>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
